# Safeguard AI Backend - Configuration

# App Configuration
APP_NAME=Safeguard AI Backend
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/safeguard-ai

# Redis Cache Configuration
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_REPORT_KEY_PREFIX=dev:analysis:reports:24hr
REDIS_REPORT_WINDOW_SECONDS=86400

# Scheduler Configuration

# Enable periodic ingestion of market data
SCHEDULER_ENABLED=true
# Interval between ingestion cycles in minutes
SCHEDULER_INTERVAL_MINUTES=5
# Use sample data instead of real API
SCHEDULER_USE_SAMPLE_DATA=true
# Number of sample candles to generate
SCHEDULER_SAMPLE_COUNT=50
# Comma-separated list of instruments to analyze
SCHEDULER_INSTRUMENTS=AAPL,MSFT,BTCUSD

# Data Source Configuration

# Optional external API URL for live market data
SOURCE_API_URL=
SOURCE_API_TIMEOUT_SECONDS=10

# Pattern Detection Engine Configuration

# Maximum number of patterns to consider for context analysis
MAX_PATTERNS_FOR_CONTEXT=5
TIMEFRAME=1H

# Kafka Configuration

# Enable Kafka consumer for streaming financial data
KAFKA_ENABLED=true
# Comma-separated list of Kafka bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Topic names for financial price updates (by timeframe)
KAFKA_TOPIC_1H=financial-1h
KAFKA_TOPIC_1M=financial-1m
KAFKA_TOPIC_1Y=financial-1y
# Consumer group IDs (by timeframe)
KAFKA_GROUP_ID_1H=safeguard-consumer-1h
KAFKA_GROUP_ID_1M=safeguard-consumer-1m
KAFKA_GROUP_ID_1Y=safeguard-consumer-1y

# Pattern Engine Configuration
CS50_ENGINE_ENABLED=true
CS50_ENGINE_PATH=

